# URL base de la API pública de Atonik. En producción apunta al backend real,
# nunca lo dejes hardcodeado en el código.
VITE_API_URL=http://localhost:8080

# url_name de la productora en Atonik (catálogo separado por entorno).
VITE_PRODUCER_URLNAME=we-gather

# Esquema de deep link de la app móvil de Atonik (ver apps/mobile/app/_layout.tsx).
VITE_APP_SCHEME=atonik
