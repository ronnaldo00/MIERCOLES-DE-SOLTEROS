# Build que se publica en Firebase Hosting mientras el sitio es una PREVIEW para
# el organizador: apunta al backend de testing, no al real. La API de testing
# admite por CORS *.atonik.co, *.web.app y *.firebaseapp.com, así que el sitio
# desplegado la consume sin cambios en el backend.
# Para pasar a producción de verdad: cambiar a
# https://atonik-flask-667525490941.us-central1.run.app y migrar los datos.
VITE_API_URL=https://atonik-flask-test-4ommpkzamq-uc.a.run.app

# url_name de la productora en Atonik (catálogo separado por entorno).
VITE_PRODUCER_URLNAME=we-gather

# Esquema de deep link de la app móvil de Atonik (ver apps/mobile/app/_layout.tsx).
VITE_APP_SCHEME=atonik
